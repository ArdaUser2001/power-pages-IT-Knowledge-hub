<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>IT Service Desk Template Generator</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f3f4f6;
            color: #1f2937;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 28px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        h1 {
            margin-top: 0;
        }

        .subtitle {
            color: #6b7280;
            margin-bottom: 30px;
        }

        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .field {
            margin-bottom: 18px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            font-size: 14px;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        .permissions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 8px;
        }

        .checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f9fafb;
            padding: 10px;
            border-radius: 6px;
        }

        .checkbox input {
            width: auto;
        }

        .checkbox label {
            margin: 0;
            font-weight: normal;
        }

        button {
            padding: 11px 18px;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
        }

        .primary {
            background: #2563eb;
            color: white;
        }

        .secondary {
            background: #e5e7eb;
        }

        .button-row {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        #output {
            margin-top: 25px;
            min-height: 180px;
            font-family: Consolas, monospace;
        }

        .hidden {
            display: none;
        }

        .section-title {
            margin-top: 28px;
            margin-bottom: 15px;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 7px;
        }

        #copyStatus {
            margin-left: 10px;
            color: #059669;
            font-weight: 600;
        }

        @media (max-width: 650px) {
            .row {
                grid-template-columns: 1fr;
            }

            .permissions {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <div class="card">

        <h1>🎫 IT Service Desk Template Generator</h1>

        <div class="subtitle">
            Generate reusable ticket documentation without rewriting the same text every time.
        </div>

        <!-- Language -->

        <div class="row">

            <div class="field">
                <label>Language / Sprache</label>

                <select id="language" onchange="updateUI()">
                    <option value="en">English</option>
                    <option value="de">Deutsch</option>
                </select>
            </div>

            <div class="field">
                <label id="topicLabel">Topic</label>

                <select id="topic" onchange="updateUI()">
                    <option value="ooo">Out of Office (OOO)</option>
                    <option value="delegation">Delegation</option>
                </select>
            </div>

        </div>


        <!-- ====================== -->
        <!-- OOO -->
        <!-- ====================== -->

        <div id="oooSection">

            <h3 class="section-title" id="oooTitle">
                Out of Office
            </h3>

            <div class="field">
                <label id="oooMailboxLabel">
                    Mailbox / User
                </label>

                <input
                    type="text"
                    id="oooMailbox"
                    placeholder="john.doe@company.com"
                >
            </div>

            <div class="row">

                <div class="field">

                    <label id="startDateLabel">
                        Start date
                    </label>

                    <input type="date" id="startDate">

                </div>

                <div class="field">

                    <label id="endDateLabel">
                        End date
                    </label>

                    <input type="date" id="endDate">

                </div>

            </div>

            <div class="field">

                <label id="oooMessageLabel">
                    OOO message (optional)
                </label>

                <textarea
                    id="oooMessage"
                    placeholder="Optional OOO message..."
                ></textarea>

            </div>

        </div>


        <!-- ====================== -->
        <!-- Delegation -->
        <!-- ====================== -->

        <div id="delegationSection" class="hidden">

            <h3 class="section-title" id="delegationTitle">
                Mailbox Delegation
            </h3>

            <div class="row">

                <div class="field">

                    <label id="mailboxLabel">
                        Mailbox
                    </label>

                    <input
                        type="text"
                        id="mailbox"
                        placeholder="shared.mailbox@company.com"
                    >

                </div>


                <div class="field">

                    <label id="delegateLabel">
                        Delegate / User
                    </label>

                    <input
                        type="text"
                        id="delegate"
                        placeholder="john.doe@company.com"
                    >

                </div>

            </div>


            <div class="row">

                <div class="field">

                    <label id="methodLabel">
                        Administration method
                    </label>

                    <select id="method">

                        <option value="Exchange Admin Center">
                            Exchange Admin Center
                        </option>

                        <option value="Symprex">
                            Symprex
                        </option>

                    </select>

                </div>


                <div class="field">

                    <label id="actionLabel">
                        Action
                    </label>

                    <select id="action">

                        <option value="grant">
                            Grant permissions
                        </option>

                        <option value="remove">
                            Remove permissions
                        </option>

                        <option value="change">
                            Change permissions
                        </option>

                    </select>

                </div>

            </div>


            <div class="field">

                <label id="permissionsLabel">
                    Permissions
                </label>

                <div class="permissions">

                    <div class="checkbox">
                        <input
                            type="checkbox"
                            id="fullAccess"
                            value="Full Access"
                        >

                        <label for="fullAccess">
                            Full Access
                        </label>
                    </div>


                    <div class="checkbox">
                        <input
                            type="checkbox"
                            id="sendAs"
                            value="Send As"
                        >

                        <label for="sendAs">
                            Send As
                        </label>
                    </div>


                    <div class="checkbox">
                        <input
                            type="checkbox"
                            id="sendOnBehalf"
                            value="Send on Behalf"
                        >

                        <label for="sendOnBehalf">
                            Send on Behalf
                        </label>
                    </div>


                    <div class="checkbox">
                        <input
                            type="checkbox"
                            id="inbox"
                            value="Inbox"
                        >

                        <label for="inbox">
                            Inbox
                        </label>
                    </div>


                    <div class="checkbox">
                        <input
                            type="checkbox"
                            id="calendar"
                            value="Calendar"
                        >

                        <label for="calendar">
                            Calendar
                        </label>
                    </div>

                </div>

            </div>


            <div class="field">

                <label id="additionalNotesLabel">
                    Additional notes
                </label>

                <textarea
                    id="additionalNotes"
                    placeholder="Optional additional information..."
                ></textarea>

            </div>

        </div>


        <!-- Buttons -->

        <div class="button-row">

            <button
                class="primary"
                onclick="generateTemplate()"
                id="generateButton"
            >
                Generate Template
            </button>

            <button
                class="secondary"
                onclick="copyOutput()"
                id="copyButton"
            >
                Copy
            </button>

            <button
                class="secondary"
                onclick="clearForm()"
                id="clearButton"
            >
                Clear
            </button>

            <span id="copyStatus"></span>

        </div>


        <!-- Output -->

        <div class="field">

            <h3 class="section-title" id="resultTitle">
                Generated Ticket Note
            </h3>

            <textarea
                id="output"
                placeholder="Your generated ticket note will appear here..."
            ></textarea>

        </div>

    </div>

</div>


<script>

/*
=========================================
LANGUAGE / UI TEXT
=========================================
*/

const uiText = {

    en: {

        topic: "Topic",

        oooTitle: "Out of Office",
        oooMailbox: "Mailbox / User",
        startDate: "Start date",
        endDate: "End date",
        oooMessage: "OOO message (optional)",

        delegationTitle: "Mailbox Delegation",
        mailbox: "Mailbox",
        delegate: "Delegate / User",
        method: "Administration method",
        action: "Action",
        permissions: "Permissions",
        notes: "Additional notes",

        generate: "Generate Template",
        copy: "Copy",
        clear: "Clear",

        result: "Generated Ticket Note",

        copied: "Copied!"
    },


    de: {

        topic: "Thema",

        oooTitle: "Abwesenheitsnotiz",
        oooMailbox: "Postfach / Benutzer",
        startDate: "Startdatum",
        endDate: "Enddatum",
        oooMessage: "Abwesenheitsnachricht (optional)",

        delegationTitle: "Postfachdelegierung",
        mailbox: "Postfach",
        delegate: "Delegierter Benutzer",
        method: "Administrationsmethode",
        action: "Aktion",
        permissions: "Berechtigungen",
        notes: "Zusätzliche Informationen",

        generate: "Vorlage erstellen",
        copy: "Kopieren",
        clear: "Leeren",

        result: "Generierte Ticket-Dokumentation",

        copied: "Kopiert!"
    }

};


/*
=========================================
UPDATE UI
=========================================
*/

function updateUI() {

    const language =
        document.getElementById("language").value;

    const topic =
        document.getElementById("topic").value;

    const text =
        uiText[language];


    document.getElementById("topicLabel").innerText =
        text.topic;

    document.getElementById("oooTitle").innerText =
        text.oooTitle;

    document.getElementById("oooMailboxLabel").innerText =
        text.oooMailbox;

    document.getElementById("startDateLabel").innerText =
        text.startDate;

    document.getElementById("endDateLabel").innerText =
        text.endDate;

    document.getElementById("oooMessageLabel").innerText =
        text.oooMessage;

    document.getElementById("delegationTitle").innerText =
        text.delegationTitle;

    document.getElementById("mailboxLabel").innerText =
        text.mailbox;

    document.getElementById("delegateLabel").innerText =
        text.delegate;

    document.getElementById("methodLabel").innerText =
        text.method;

    document.getElementById("actionLabel").innerText =
        text.action;

    document.getElementById("permissionsLabel").innerText =
        text.permissions;

    document.getElementById("additionalNotesLabel").innerText =
        text.notes;

    document.getElementById("generateButton").innerText =
        text.generate;

    document.getElementById("copyButton").innerText =
        text.copy;

    document.getElementById("clearButton").innerText =
        text.clear;

    document.getElementById("resultTitle").innerText =
        text.result;


    /*
    Show correct section
    */

    if (topic === "ooo") {

        document
            .getElementById("oooSection")
            .classList.remove("hidden");

        document
            .getElementById("delegationSection")
            .classList.add("hidden");

    }

    else {

        document
            .getElementById("oooSection")
            .classList.add("hidden");

        document
            .getElementById("delegationSection")
            .classList.remove("hidden");

    }

}


/*
=========================================
DATE FORMATTING
=========================================
*/

function formatDate(dateString, language) {

    if (!dateString) {
        return "";
    }

    const date =
        new Date(dateString + "T00:00:00");

    if (language === "de") {

        return date.toLocaleDateString(
            "de-DE"
        );

    }

    return date.toLocaleDateString(
        "en-GB"
    );

}


/*
=========================================
GENERATE TEMPLATE
=========================================
*/

function generateTemplate() {

    const language =
        document.getElementById("language").value;

    const topic =
        document.getElementById("topic").value;


    let result = "";


    if (topic === "ooo") {

        result =
            generateOOO(language);

    }

    else if (topic === "delegation") {

        result =
            generateDelegation(language);

    }


    document.getElementById("output").value =
        result;

}


/*
=========================================
OOO TEMPLATE
=========================================
*/

function generateOOO(language) {

    const mailbox =
        document.getElementById("oooMailbox").value.trim();

    const startDate =
        formatDate(
            document.getElementById("startDate").value,
            language
        );

    const endDate =
        formatDate(
            document.getElementById("endDate").value,
            language
        );

    const message =
        document.getElementById("oooMessage").value.trim();


    if (language === "de") {

        let text =
`Die Abwesenheitsnotiz für ${mailbox || "[Postfach]"} wurde eingerichtet.`;

        if (startDate || endDate) {

            text +=
`\n\nZeitraum: ${startDate || "-"} bis ${endDate || "-"}`;

        }

        if (message) {

            text +=
`\n\nAbwesenheitsnachricht:
${message}`;

        }

        text +=
`\n\nDie Konfiguration wurde erfolgreich durchgeführt.`;

        return text;

    }


    else {

        let text =
`The Out of Office notification for ${mailbox || "[mailbox]"} has been configured.`;

        if (startDate || endDate) {

            text +=
`\n\nPeriod: ${startDate || "-"} to ${endDate || "-"}`;

        }

        if (message) {

            text +=
`\n\nOut of Office message:
${message}`;

        }

        text +=
`\n\nThe configuration was completed successfully.`;

        return text;

    }

}


/*
=========================================
DELEGATION TEMPLATE
=========================================
*/

function generateDelegation(language) {

    const mailbox =
        document.getElementById("mailbox").value.trim();

    const delegate =
        document.getElementById("delegate").value.trim();

    const method =
        document.getElementById("method").value;

    const action =
        document.getElementById("action").value;

    const notes =
        document.getElementById("additionalNotes").value.trim();


    const permissions = [];


    if (document.getElementById("fullAccess").checked) {

        permissions.push("Full Access");

    }

    if (document.getElementById("sendAs").checked) {

        permissions.push("Send As");

    }

    if (document.getElementById("sendOnBehalf").checked) {

        permissions.push("Send on Behalf");

    }

    if (document.getElementById("inbox").checked) {

        permissions.push(
            language === "de"
                ? "Posteingang"
                : "Inbox"
        );

    }

    if (document.getElementById("calendar").checked) {

        permissions.push(
            language === "de"
                ? "Kalender"
                : "Calendar"
        );

    }


    const permissionText =
        permissions.length > 0
            ? permissions.join(", ")
            : language === "de"
                ? "[keine Berechtigung ausgewählt]"
                : "[no permission selected]";


    /*
    German
    */

    if (language === "de") {

        let actionText = "";

        if (action === "grant") {

            actionText =
                "wurden folgende Berechtigungen vergeben";

        }

        else if (action === "remove") {

            actionText =
                "wurden folgende Berechtigungen entfernt";

        }

        else {

            actionText =
                "wurden folgende Berechtigungen angepasst";

        }


        let text =
`Die Postfachdelegierung wurde über ${method} bearbeitet.

Postfach: ${mailbox || "[Postfach]"}
Benutzer: ${delegate || "[Benutzer]"}

Für den Benutzer ${delegate || "[Benutzer]"} ${actionText}:
${permissionText}`;

        if (notes) {

            text +=
`\n\nZusätzliche Informationen:
${notes}`;

        }

        text +=
`\n\nDie Konfiguration wurde erfolgreich durchgeführt.`;

        return text;

    }


    /*
    English
    */

    else {

        let actionText = "";

        if (action === "grant") {

            actionText =
                "were granted";

        }

        else if (action === "remove") {

            actionText =
                "were removed";

        }

        else {

            actionText =
                "were updated";

        }


        let text =
`The mailbox delegation was processed via ${method}.

Mailbox: ${mailbox || "[mailbox]"}
User: ${delegate || "[user]"}

The following permissions ${actionText} for ${delegate || "[user]"}:
${permissionText}`;

        if (notes) {

            text +=
`\n\nAdditional information:
${notes}`;

        }

        text +=
`\n\nThe configuration was completed successfully.`;

        return text;

    }

}


/*
=========================================
COPY
=========================================
*/

function copyOutput() {

    const output =
        document.getElementById("output");

    const language =
        document.getElementById("language").value;

    if (!output.value) {
        return;
    }

    navigator.clipboard
        .writeText(output.value)
        .then(() => {

            const status =
                document.getElementById("copyStatus");

            status.innerText =
                uiText[language].copied;

            setTimeout(() => {

                status.innerText = "";

            }, 1500);

        });

}


/*
=========================================
CLEAR
=========================================
*/

function clearForm() {

    document
        .querySelectorAll(
            'input[type="text"], input[type="date"], textarea'
        )
        .forEach(element => {

            element.value = "";

        });


    document
        .querySelectorAll(
            'input[type="checkbox"]'
        )
        .forEach(element => {

            element.checked = false;

        });


    document.getElementById("output").value = "";

}


/*
Initial UI
*/

updateUI();

</script>

</body>
</html>
